# Copy to .env and adjust. Everything except APP_PASSWORD can also be changed in the app's Settings tab.

# Moonraker on the Voron (Mainsail/Fluidd talk to the same URL)
MOONRAKER_URL=http://voron.local:7125
MOONRAKER_API_KEY=
PRINTER_NAME=Voron 2.4

# Webcam (leave empty to auto-discover from Moonraker in Settings)
WEBCAM_STREAM_URL=
WEBCAM_SNAPSHOT_URL=

# Password for the app. Strongly recommended if you expose it outside your LAN.
APP_PASSWORD=

# Port on the host
PORT=8080

# Only for docker-compose.tailscale.yml
TS_AUTHKEY=
